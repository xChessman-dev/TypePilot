<Window x:Class="TypePilot.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TypePilot — помощник набора" Width="1180" Height="840" MinWidth="960" MinHeight="720" WindowStartupLocation="CenterScreen" Icon="Assets/TypePilot.ico" Loaded="WindowLoaded" SourceInitialized="WindowSourceInitialized" Closing="WindowClosing">
  <Grid Background="{StaticResource Page}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="184" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <Grid Margin="16,24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="8,0,0,24"><Border Background="{StaticResource Accent}" CornerRadius="8" Width="32" Height="32"><Path Data="M 9,9 L 23,9 M 16,9 L 16,24 M 21,21 L 25,17 M 21,17 L 25,17 L 25,21" Stroke="{StaticResource AccentText}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Border><TextBlock Text="TypePilot" FontWeight="SemiBold" FontSize="19" Margin="10,3,0,0" /></StackPanel>
          <RadioButton x:Name="EditorNav" Style="{StaticResource Nav}" GroupName="Nav" Tag="Editor" IsChecked="True" Checked="Navigate" Content="Редактор" />
          <RadioButton x:Name="DictionaryNav" Style="{StaticResource Nav}" GroupName="Nav" Tag="Dictionary" Checked="Navigate" Content="Личный словарь" />
          <RadioButton x:Name="SettingsNav" Style="{StaticResource Nav}" GroupName="Nav" Tag="Settings" Checked="Navigate" Content="Настройки" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="8,0"><TextBlock Text="ЛОКАЛЬНО / 01" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" /><TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="Никакой телеметрии.&#10;Текст не сохраняется." /></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="28,24,28,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Пиши свободно." FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Опечатки — поправим. Мысль — сохраним." Style="{StaticResource Hint}" Margin="0,6,0,0" /></StackPanel><Border Grid.Column="1" Background="{StaticResource Surface}" CornerRadius="6" Padding="12,8" VerticalAlignment="Top"><TextBlock Text="Windows / C#" Foreground="{StaticResource Muted}" FontSize="12" /></Border></Grid>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,20">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Status}" FontWeight="SemiBold" /><TextBlock x:Name="GlobalStatus" Text="Т9 в редакторе · системный режим выключен" Style="{StaticResource Hint}" Margin="0,5,16,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><CheckBox Content="Автоисправление" IsChecked="{Binding AutoCorrect}" Margin="0,0,16,0" VerticalAlignment="Center" /><Button x:Name="UndoButton" Content="Отменить" IsEnabled="False" Click="UndoCorrection" Padding="14,8" ToolTip="Отменить последнее исправление. Можно нажать Backspace сразу после него." /></StackPanel></Grid>
      </Border>
      <ScrollViewer x:Name="PageScroll" Grid.Row="2" Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,12,0">
          <Grid x:Name="EditorPage">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="20">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="Твой текст" Style="{StaticResource Heading}" /><TextBlock Grid.Row="1" Text="Печатай как обычно. Частые опечатки исправляются после пробела." Style="{StaticResource Hint}" MinHeight="40" Margin="0,8,0,16" />
                <Border Grid.Row="2" Height="40" Background="{StaticResource Input}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="12,8"><TextBlock Text="Т9 + словарь Windows" Foreground="{StaticResource Accent}" /></Border>
                <TextBox x:Name="EditorBox" Grid.Row="3" Text="{Binding Editor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Твой текст" AcceptsReturn="True" TextWrapping="Wrap" Height="180" MaxLength="20000" FontSize="17" TextChanged="EditorChanged" SelectionChanged="EditorSelectionChanged" PreviewKeyDown="EditorPreviewKeyDown" SpellCheck.IsEnabled="True" Language="ru-RU" />
                <ItemsControl Grid.Row="4" ItemsSource="{Binding Suggestions}" Margin="0,12,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Word}" Tag="{Binding}" ToolTip="{Binding Reason}" Click="AcceptSuggestion" Margin="0,0,8,8" Padding="12,8" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Grid.Row="5" x:Name="SuggestionHint" Text="Подсказки появятся во время набора. Tab — принять первую." Style="{StaticResource Hint}" Margin="0,4,0,12" />
                <DockPanel Grid.Row="6"><TextBlock Text="{Binding CharacterCount, StringFormat={}{0} символов}" Style="{StaticResource Hint}" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Очистить" Command="{Binding ClearCommand}" Margin="8,0,0,0" /><Button Content="Копировать" Command="{Binding CopyEditorCommand}" Margin="8,0,0,0" /></StackPanel></DockPanel>
              </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="Та же мысль. Яснее." Style="{StaticResource Heading}" /><TextBlock Grid.Row="1" Text="Локальный ИИ меняет только текст, который ты передашь ему кнопкой." Style="{StaticResource Hint}" MinHeight="40" Margin="0,8,0,16" />
                <ComboBox Grid.Row="2" x:Name="StyleBox" SelectedIndex="0" SelectionChanged="StyleChanged" Margin="0,0,0,12" AutomationProperties.Name="Стиль переформулировки"><ComboBoxItem Content="Яснее и естественнее" /><ComboBoxItem Content="Короче, без потери сути" /><ComboBoxItem Content="Вежливее" /><ComboBoxItem Content="Только ошибки и пунктуация" /></ComboBox>
                <TextBox Grid.Row="3" Text="{Binding Result, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Результат ИИ" AcceptsReturn="True" TextWrapping="Wrap" Height="180" FontSize="16" />
                <TextBlock Grid.Row="4" Text="{Binding AiStatus}" Style="{StaticResource Hint}" Margin="0,12,0,16" />
                <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="Переформулировать" Command="{Binding RewriteCommand}" Style="{StaticResource Primary}" /><Button Grid.Column="1" Content="Стоп" Command="{Binding CancelCommand}" Margin="8,0,0,0" /></Grid>
                <WrapPanel Grid.Row="6" Margin="0,12,0,0"><Button Content="Применить" Command="{Binding ApplyCommand}" Margin="0,0,8,8" /><Button Content="Копировать" Command="{Binding CopyResultCommand}" Margin="0,0,0,8" /></WrapPanel>
              </Grid>
            </Border>
          </Grid>
          <StackPanel x:Name="DictionaryPage" Visibility="Collapsed">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Слова, которые знаешь ты" Style="{StaticResource Heading}" /><TextBlock Text="Ники, имена, сленг и названия проектов. Эти слова не исправляются. По одному слову в строке." Style="{StaticResource Hint}" Margin="0,8,0,16" /><TextBox Text="{Binding DictionaryText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Личный словарь" AcceptsReturn="True" TextWrapping="Wrap" Height="280" MaxLength="200000" /><WrapPanel Margin="0,16,0,0"><Button Content="Сохранить словарь" Command="{Binding SaveCommand}" Style="{StaticResource Primary}" Margin="0,0,8,8" /><Button Content="Импорт TXT" Click="ImportDictionary" Margin="0,0,8,8" /><Button Content="Экспорт TXT" Click="ExportDictionary" Margin="0,0,0,8" /></WrapPanel></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,20,0,0"><StackPanel><TextBlock Text="Без незаметного обучения" FontWeight="SemiBold" /><TextBlock Text="TypePilot не сохраняет переписку и не собирает историю нажатий. Личный словарь заполняется только тобой." Style="{StaticResource Hint}" Margin="0,8,0,0" /></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Набор и интеграция" Style="{StaticResource Heading}" /><CheckBox Content="Поправлять случайно выбранную раскладку" IsChecked="{Binding FixLayout}" /><CheckBox Content="Автоисправления в совместимых полях Windows" IsChecked="{Binding GlobalEnabled}" /><TextBlock Text="Опционально: классические Edit / RichEdit. Не все поля браузера, Discord или Telegram поддерживают этот режим. Неизвестные поля не меняются. Ctrl+Alt+Space — взять выделенный текст в редактор; Ctrl+Alt+Backspace — отменить системное исправление." Style="{StaticResource Hint}" Margin="0,8,0,16" /><TextBlock Text="Разрешённые приложения (имя процесса без .exe)" FontWeight="SemiBold" Margin="0,0,0,8" /><TextBox Text="{Binding AllowedText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="120" AutomationProperties.Name="Разрешённые процессы" /><TextBlock Text="Пароли, терминалы, редакторы кода и известные игры исключены независимо от списка. Программа не требует прав администратора." Style="{StaticResource Hint}" Margin="0,12,0,0" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,20,0,0"><StackPanel><TextBlock Text="ИИ без фонового расхода" Style="{StaticResource Heading}" /><TextBlock Text="Qwen3 4B · Vulkan / GPU · 2 потока CPU. Модель запускается по запросу и выгружается через 30 секунд простоя. Нагрузка при генерации всё равно может влиять на игру." Style="{StaticResource Hint}" Margin="0,8,0,16" /><TextBlock Text="Папка модели и движка" FontWeight="SemiBold" Margin="0,0,0,8" /><TextBox Text="{Binding AiRoot, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Папка локального ИИ" /><WrapPanel Margin="0,16,0,0"><Button Content="Выгрузить ИИ" Command="{Binding UnloadCommand}" Margin="0,0,8,8" /><Button Content="Сохранить настройки" Command="{Binding SaveCommand}" Style="{StaticResource Primary}" Margin="0,0,0,8" /></WrapPanel><TextBlock x:Name="SpellingStatus" Style="{StaticResource Hint}" Margin="0,8,0,0" /></StackPanel></Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="ResourceStatus" Style="{StaticResource Hint}" Text="Без нейросети на каждую клавишу" /><TextBlock Grid.Column="1" Text="{Binding Corrections, StringFormat={}Исправлений за сессию: {0}}" Style="{StaticResource Hint}" /></Grid>
    </Grid>
  </Grid>
</Window>
