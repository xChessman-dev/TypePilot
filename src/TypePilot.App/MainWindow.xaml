<Window x:Class="TypePilot.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="TypePilot — помощник набора" Width="1180" Height="840" MinWidth="960" MinHeight="720" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Icon="Assets/TypePilot.ico" Loaded="WindowLoaded" SourceInitialized="WindowSourceInitialized" Closing="WindowClosing">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
  <Grid Background="{StaticResource Page}">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/><RowDefinition Height="36"/></Grid.RowDefinitions>
    <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0"><Image Source="Assets/TypePilot.ico" Width="26" Height="26" Margin="0,0,10,0"/><TextBlock Text="TypePilot" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Помощник набора" Style="{StaticResource Hint}" Margin="16,0,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Click="MinimizeClick" Style="{StaticResource WindowButton}" AutomationProperties.Name="Свернуть"><Path Data="M0,0 L12,0" Stroke="{StaticResource Text}" StrokeThickness="1.5"/></Button><Button Click="MaximizeClick" Style="{StaticResource WindowButton}" AutomationProperties.Name="Развернуть"><Path Data="M0,0 L10,0 10,10 0,10 Z" Stroke="{StaticResource Text}" StrokeThickness="1.3"/></Button><Button Click="CloseClick" Style="{StaticResource WindowButton}" AutomationProperties.Name="Скрыть в трей"><Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource Text}" StrokeThickness="1.5"/></Button></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="192"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="16,28,16,20">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" Foreground="{StaticResource Muted}" FontSize="10" Margin="8,0,0,18"/>
            <RadioButton x:Name="HomeNav" Style="{StaticResource Nav}" GroupName="Nav" Tag="Home" IsChecked="True" Checked="Navigate"><StackPanel Orientation="Horizontal"><Path Data="M1,10 L11,1 21,10 M4,8 L4,21 9,21 9,14 14,14 14,21 19,21 19,8" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="18" Height="20" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="Главная" VerticalAlignment="Center"/></StackPanel></RadioButton>
            <RadioButton x:Name="EditorNav" Style="{StaticResource Nav}" GroupName="Nav" Tag="Editor" Checked="Navigate"><StackPanel Orientation="Horizontal"><Path Data="M3,1 L17,1 17,21 3,21 Z M6,6 L14,6 M6,10 L14,10 M6,14 L12,14" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="18" Height="20" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="Редактор" VerticalAlignment="Center"/></StackPanel></RadioButton>
            <RadioButton x:Name="DictionaryNav" Style="{StaticResource Nav}" GroupName="Nav" Tag="Dictionary" Checked="Navigate"><StackPanel Orientation="Horizontal"><Path Data="M1,2 L9,2 11,4 13,2 21,2 21,20 13,20 11,22 9,20 1,20 Z M11,4 L11,22" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="18" Height="20" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="Словарь" VerticalAlignment="Center"/></StackPanel></RadioButton>
            <RadioButton x:Name="SettingsNav" Style="{StaticResource Nav}" GroupName="Nav" Tag="Settings" Checked="Navigate"><StackPanel Orientation="Horizontal"><Path Data="M1,4 L21,4 M1,11 L21,11 M1,18 L21,18 M6,1 L6,7 M16,8 L16,14 M9,15 L9,21" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" Width="18" Height="20" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="Настройки" VerticalAlignment="Center"/></StackPanel></RadioButton>
          </StackPanel>
          <Border Grid.Row="2" Background="{StaticResource Input}" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="ТОЛЬКО ЛОКАЛЬНО" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Без журналов нажатий. ИИ включается только по запросу." Style="{StaticResource Hint}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="28,24,20,16" MaxWidth="1320"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid Margin="0,0,8,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Пиши. Мы рядом." FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Т9 поверх поля ввода. ИИ — когда он нужен тебе." Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="Свернуть в трей" Click="HideToTrayClick" Padding="16,8" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,8,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding Status}" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="GlobalStatus" Text="Подготавливаем фоновый Т9…" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel><CheckBox Grid.Column="1" Content="Т9 в фоне" IsChecked="{Binding GlobalEnabled}" VerticalAlignment="Center"/></Grid></Border>
        <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="0,0,8,0">
            <StackPanel x:Name="HomePage">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="01 / НАБОР" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Т9 без отдельного окна" Style="{StaticResource Heading}" Margin="0,10,0,8"/><TextBlock Text="Печатай в доступном поле приложения. Подсказки появляются рядом и не забирают фокус." Style="{StaticResource Hint}" MinHeight="60"/><CheckBox Content="Показывать подсказки рядом" IsChecked="{Binding ShowSuggestions}" Margin="0,16,0,8"/><CheckBox Content="Исправлять частые опечатки" IsChecked="{Binding AutoCorrect}"/><TextBlock Text="Tab → вариант 1 / 2 / 3 · пауза — принять&#10;Escape — оставить · два пробела → точка&#10;Ctrl+Alt+Backspace — отменить" Style="{StaticResource Hint}" Margin="0,16,0,0"/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="02 / МЫСЛЬ" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="ИИ одной комбинацией" Style="{StaticResource Heading}" Margin="0,10,0,8"/><TextBlock Text="Выдели фразу в исходном приложении. Горячая клавиша сразу запускает переформулировку." Style="{StaticResource Hint}" MinHeight="60"/><Border Background="{StaticResource Input}" CornerRadius="8" Padding="16" Margin="0,16,0,12"><TextBlock Text="Ctrl + Alt + Space" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/></Border><TextBlock Text="Проверь предпросмотр → «Заменить в поле». Сообщения никогда не отправляются автоматически." Style="{StaticResource Hint}"/></StackPanel></Border>
              </Grid>
              <Border Style="{StaticResource Card}" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="Сначала попробуй на черновике" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Совместимость зависит от текстового поля. Пароли, игры и редакторы кода исключены. Если подсказок нет — поле может не поддерживаться." Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel><Button Grid.Column="1" Content="Открыть редактор" Click="OpenEditorClick" VerticalAlignment="Center" Padding="16,8"/></Grid></Border>
              <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="ИИ не работает на каждую букву" FontWeight="SemiBold"/><TextBlock Text="{Binding AiStatus}" Style="{StaticResource Hint}" Margin="0,8,0,0"/><TextBlock Text="Модель выгружается через 30 секунд простоя. Набор продолжает работать без GPU." Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel></Border>
            </StackPanel>
            <Grid x:Name="EditorPage" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Черновик и проверка Т9" Style="{StaticResource Heading}"/><TextBlock Text="Частые опечатки исправляются после пробела. Подсказки — клавишей Tab." Style="{StaticResource Hint}" MinHeight="60" Margin="0,8,0,16"/><TextBox x:Name="EditorBox" Text="{Binding Editor,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Твой текст" AcceptsReturn="True" TextWrapping="Wrap" Height="220" MaxLength="20000" FontSize="17" TextChanged="EditorChanged" SelectionChanged="EditorSelectionChanged" PreviewKeyDown="EditorPreviewKeyDown" SpellCheck.IsEnabled="True" Language="ru-RU"/><ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,12,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Word}" Tag="{Binding}" ToolTip="{Binding Reason}" Click="AcceptSuggestion" Margin="0,0,8,8" Padding="12,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="SuggestionHint" Text="Подсказки появятся во время набора." Style="{StaticResource Hint}" Margin="0,4,0,12"/><WrapPanel><Button x:Name="UndoButton" Content="Отменить" IsEnabled="False" Click="UndoCorrection" Margin="0,0,8,8" Padding="12,8"/><Button Content="Очистить" Command="{Binding ClearCommand}" Margin="0,0,8,8" Padding="12,8"/><Button Content="Копировать" Command="{Binding CopyEditorCommand}" Margin="0,0,0,8" Padding="12,8"/></WrapPanel><TextBlock Text="{Binding CharacterCount,StringFormat={}{0} символов}" Style="{StaticResource Hint}"/></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Та же мысль. Яснее." Style="{StaticResource Heading}"/><TextBlock Text="Этот редактор — запасной вариант для полей, которые Windows не позволяет изменить." Style="{StaticResource Hint}" MinHeight="60" Margin="0,8,0,16"/><ComboBox x:Name="StyleBox" SelectedIndex="0" SelectionChanged="StyleChanged" Margin="0,0,0,12" AutomationProperties.Name="Стиль переформулировки"><ComboBoxItem Content="Яснее и естественнее"/><ComboBoxItem Content="Короче, без потери сути"/><ComboBoxItem Content="Вежливее"/><ComboBoxItem Content="Только ошибки и пунктуация"/></ComboBox><TextBox Text="{Binding Result,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Результат ИИ" AcceptsReturn="True" TextWrapping="Wrap" Height="180" FontSize="16"/><TextBlock Text="{Binding AiStatus}" Style="{StaticResource Hint}" Margin="0,12,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Переформулировать" Command="{Binding RewriteCommand}" Style="{StaticResource Primary}"/><Button Grid.Column="1" Content="Стоп" Command="{Binding CancelCommand}" Margin="8,0,0,0"/></Grid><WrapPanel Margin="0,12,0,0"><Button Content="В черновик" Command="{Binding ApplyCommand}" Margin="0,0,8,8"/><Button Content="Копировать" Command="{Binding CopyResultCommand}" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border>
            </Grid>
            <StackPanel x:Name="DictionaryPage" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Слова, которые знаешь ты" Style="{StaticResource Heading}"/><TextBlock Text="Ники, имена, сленг и проекты. Эти слова не исправляются. По одному слову в строке." Style="{StaticResource Hint}" Margin="0,8,0,16"/><TextBox Text="{Binding DictionaryText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Личный словарь" AcceptsReturn="True" TextWrapping="Wrap" Height="280" MaxLength="200000"/><WrapPanel Margin="0,16,0,0"><Button Content="Сохранить словарь" Command="{Binding SaveCommand}" Style="{StaticResource Primary}" Margin="0,0,8,8"/><Button Content="Импорт TXT" Click="ImportDictionary" Margin="0,0,8,8"/><Button Content="Экспорт TXT" Click="ExportDictionary" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Без незаметного обучения" FontWeight="SemiBold"/><TextBlock Text="Переписка и история нажатий не сохраняются. Словарь заполняется только тобой." Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel></Border></StackPanel>
            <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Набор и интеграция" Style="{StaticResource Heading}"/><CheckBox Content="Т9 в фоне" IsChecked="{Binding GlobalEnabled}"/><CheckBox Content="Подсказки рядом с полем" IsChecked="{Binding ShowSuggestions}"/><CheckBox Content="Автоисправление частых опечаток" IsChecked="{Binding AutoCorrect}"/><CheckBox Content="Поправлять случайную раскладку" IsChecked="{Binding FixLayout}"/><CheckBox Content="Tab перебирает варианты 1 → 2 → 3" IsChecked="{Binding TabSelection}"/><TextBlock Text="Выбор вставляется после паузы 0,6 с. Escape или продолжение набора отменяют выбор. Без подсказок Tab работает как обычно. Ctrl+Alt+1 / 2 / 3 — принять сразу; Ctrl+Alt+Backspace — отменить." Style="{StaticResource Hint}" Margin="0,8,0,16"/><TextBlock Text="Разрешённые приложения (процессы без .exe)" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox Text="{Binding AllowedText,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="120" AutomationProperties.Name="Разрешённые процессы"/><TextBlock Text="Пароли, терминалы, редакторы кода и известные игры исключены независимо от списка. Права администратора не нужны." Style="{StaticResource Hint}" Margin="0,12,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Буквы и знаки" Style="{StaticResource Heading}"/><CheckBox Content="Заглавная буква в начале предложения" IsChecked="{Binding AutoCapitalize}"/><CheckBox Content="Поправлять пробелы вокруг знаков" IsChecked="{Binding SmartPunctuation}"/><CheckBox Content="Двойной пробел → точка и пробел" IsChecked="{Binding DoubleSpacePeriod}"/><TextBlock Text="Правки после завершения слова, без запуска ИИ. Даты, адреса и ссылки исключены. Запятые по смыслу: выдели фразу → Ctrl+Alt+Space → «Только ошибки и пунктуация»." Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Локальная переформулировка" Style="{StaticResource Heading}"/><TextBlock Text="Qwen3 4B · GPU / Vulkan · 2 потока CPU. Запуск только по запросу, выгрузка через 30 секунд. Генерация может влиять на игру." Style="{StaticResource Hint}" Margin="0,8,0,16"/><TextBlock Text="Папка модели и движка" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox Text="{Binding AiRoot,UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Папка локального ИИ"/><WrapPanel Margin="0,16,0,0"><Button Content="Выгрузить ИИ" Command="{Binding UnloadCommand}" Margin="0,0,8,8"/><Button Content="Сохранить настройки" Command="{Binding SaveCommand}" Style="{StaticResource Primary}" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="SpellingStatus" Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel></Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ResourceStatus" Style="{StaticResource Hint}" FontSize="12" Text="Т9 без нейросети на каждую клавишу"/><TextBlock Grid.Column="1" Text="{Binding Corrections,StringFormat={}Исправлений: {0}}" Style="{StaticResource Hint}" FontSize="12"/></Grid></Border>
  </Grid>
  </Border>
</Window>
